# Google Gemini API Key (Required for AI Chatbot & AI Itinerary Generation)
# Get a free key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# OpenWeather API Key (Required for Live Real-Time Weather & 5-Day Forecasts)
# Get a free key at: https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=

# Pexels API Key (Optional: for live external dynamic image fetching)
# Get a free key at: https://www.pexels.com/api/
VITE_PEXELS_API_KEY=

# Unsplash Access Key (Optional: alternative image source)
# Get a free key at: https://unsplash.com/developers
VITE_UNSPLASH_ACCESS_KEY=
